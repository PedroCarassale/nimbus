# Nimbus Functions — Variables de Entorno

# PostgreSQL Configuration (Slice 3)
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=nimbus
POSTGRES_DB=nimbus
DATABASE_URL=postgresql://nimbus:nimbus@localhost:5432/nimbus

# Redis Configuration (Slice 4: concurrency locks, Slice 5: log streams)
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# MinIO / S3 Configuration (Slice 2)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=nimbus-artifacts

# Para scripts que usan AWS CLI
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://localhost:9000

# Runner Configuration (Slice 1) y defaults del compute plane (Paso 2).
# Los límites por invocación están en docs/configuracion.md.
NIMBUS_MEMORY=128m
NIMBUS_MEMORY_MB=128
NIMBUS_TIMEOUT_SEC=5
NIMBUS_HANDLER=handler
# Vacío: el container no recibe --cpus. Si se setea, tiene que estar entre 0.1 y 4.
NIMBUS_CPUS=
NIMBUS_IMAGE=nimbus-node

# Control Plane (Slice 3)
CONTROL_PLANE_PORT=3000

# Compute Plane (Slice 4)
COMPUTE_PLANE_PORT=8080
COMPUTE_PLANE_URL=http://localhost:8080
# Directorio de trabajo compartido con el daemon de Docker.
# El path tiene que ser el mismo dentro del contenedor del compute plane y en el host,
# porque `docker run -v` lo resuelve el daemon.
NIMBUS_WORK_DIR=/tmp/nimbus-work

# Concurrencia del compute plane (Paso 1). Ver docs/concurrencia.md
NIMBUS_FN_CONCURRENCY=2
NIMBUS_FN_QUEUE_MAX=32
NIMBUS_FN_QUEUE_WAIT_SEC=30
NIMBUS_MAX_CONTAINERS=8
NIMBUS_SLOT_LEASE_SEC=30

# Containers warm (Paso 3). Ver docs/warm.md
# NIMBUS_WARM=0 vuelve al camino frío (un docker run por invoke).
NIMBUS_WARM=1
NIMBUS_WARM_IDLE_SEC=60
