# Nimbus Functions — Variables de Entorno

# PostgreSQL Configuration (Slice 3)
POSTGRES_USER=nimbus
POSTGRES_PASSWORD=nimbus
POSTGRES_DB=nimbus
DATABASE_URL=postgresql://nimbus:nimbus@localhost:5432/nimbus

# MinIO / S3 Configuration (Slice 2)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=nimbus-artifacts

# Para scripts que usan AWS CLI
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://localhost:9000

# Runner Configuration (Slice 1)
NIMBUS_MEMORY=128m
NIMBUS_TIMEOUT_SEC=5
NIMBUS_HANDLER=handler
NIMBUS_IMAGE=nimbus-node

# Control Plane (Slice 3)
CONTROL_PLANE_PORT=3000
